SESSION_SECRET=please-change-this-to-a-long-random-string

# 审稿：DeepSeek（或任意 OpenAI 兼容聊天接口）。不配则用内置规则。
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# 封面图：DeepSeek 不能出图，请另配图生接口（推荐 SiliconFlow）。
# 审核仍用上面的 DeepSeek；封面只用下面这组。
# AI_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# AI_IMAGE_API_KEY=
# AI_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 可选竖版尺寸，默认 768x1024
# AI_IMAGE_SIZE=768x1024

# Optional. Leave blank to keep activation mail on this machine (data/outbox).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=墨本 <noreply@example.com>
# Required in production. Activation and invite links use this instead of the request Host.
# APP_ORIGIN=https://example.com

# 黄果果支付：仅用于充值金币（1 元 = 10 金）。解锁/买断/征稿扣金币。
# 通道写死在代码里：005=微信，004=支付宝，下单时用户自选。
# PAY_MCH_KEY=1091
# PAY_MCH_SECRET=
# PAY_API_BASE=https://tsapi-ruihe.tsqqai.com
# 生产务必配置 APP_ORIGIN，用于 notifyUrl / returnUrl。

# 站长征稿交付页口令：/ops/requirements?key=...
# ADMIN_SECRET=
