SESSION_SECRET=please-change-this-to-a-long-random-string

# —— 方案 A：全用 Gemini（审稿 + 封面）——
# 密钥：https://aistudio.google.com/apikey
# gemini-2.0-flash 已于 2026-06-01 下线，勿再使用。
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# AI_IMAGE_PROVIDER=gemini
# AI_IMAGE_MODEL=gemini-nano-banana-2.1
# AI_IMAGE_SIZE=2:3
# 服务器 IP 被 Google 拒绝（User location is not supported）时：
# 1) 把服务器放到日本/美国/新加坡；或
# 2) 用海外中转，例如 Cloudflare Worker 反代 generativelanguage.googleapis.com：
# GEMINI_API_BASE=https://你的中转域名/v1beta
# 3) Node 24+ 且有出口代理：NODE_USE_ENV_PROXY=1 HTTPS_PROXY=http://127.0.0.1:7890

# —— 方案 B：DeepSeek 审稿 + SiliconFlow 封面 ——
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# AI_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# AI_IMAGE_API_KEY=
# AI_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# AI_IMAGE_SIZE=768x1024

# Optional. Leave blank to keep activation mail on this machine (data/outbox).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=墨本 <noreply@example.com>
# Required in production. Activation and invite links use this instead of the request Host.
# APP_ORIGIN=https://example.com

# 黄果果支付：仅用于充值金币（1 元 = 10 金）。解锁/买断/征稿扣金币。
# 通道写死在代码里：005=微信，004=支付宝，下单时用户自选。
# PAY_MCH_KEY=1091
# PAY_MCH_SECRET=
# PAY_API_BASE=https://tsapi-ruihe.tsqqai.com
# 生产务必配置 APP_ORIGIN，用于 notifyUrl / returnUrl。

# 站长征稿交付页口令：/ops/requirements?key=...
# ADMIN_SECRET=

# Markdown 开放上传：POST /api/upload/md（无需 Token/登录，一律挂主账号「大黄书」）
# 后台管理员：用户名 admin，默认密码 admin888888；生产请改掉
# ADMIN_PASSWORD=
